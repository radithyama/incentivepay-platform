# Copy to .env.prod on the server (never commit the real file - it's gitignored).
# Used by: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build

# The domain (once DNS is pointed here) or, before that, the VM's static IP.
PUBLIC_HOST=example.com
KEYCLOAK_PUBLIC_PORT=8081

# Frontend build args - baked into the JS bundle at build time. Update and
# rebuild (docker compose ... up -d --build frontend) whenever PUBLIC_HOST changes.
VITE_API_BASE_URL=https://api.example.com
VITE_LEDGER_BASE_URL=https://ledger.example.com
VITE_KEYCLOAK_URL=https://auth.example.com

# Generate with: openssl rand -hex 32
HMAC_SECRET=change-me

# Generate with: openssl rand -base64 24 | tr -d '/+='
KEYCLOAK_ADMIN_PASSWORD=change-me
